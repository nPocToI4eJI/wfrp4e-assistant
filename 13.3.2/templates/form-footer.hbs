<footer class="form-footer">
    {{#each buttons as |button|}}
    <button{{#if button.type}} type="{{button.type}}"{{/if}}{{#if button.name}} name="{{button.name}}"{{/if}}{{#if button.cssClass}} class="{{button.cssClass}}"{{/if}}{{#if button.action}} data-action="{{button.action}}"{{/if}}{{#if button.tooltip}} data-tooltip="<div style='text-align: center;'>{{localize button.tooltip}}</div>"{{/if}}{{#if button.default}} autofocus{{/if}}{{#if button.disabled}} disabled{{/if}}>
        {{#if button.icon}}<i class="{{button.icon}}" inert></i>{{/if}}
        {{#if button.label}}<span>{{localize button.label}}</span>{{/if}}
    </button>
    {{/each}}
</footer>