<nav class="tabs">
	<a class="item" data-tab="details" onclick="setTab('details')">{{localize "Details"}}</a>
	<a class="item" data-tab="characteristics" onclick="setTab('characteristics')">{{localize "Characteristics"}}</a>
	<a class="item" data-tab="skills" onclick="setTab('skills')">{{localize "Skills"}}</a>
	<a class="item" data-tab="trappings" onclick="setTab('trappings')">{{localize "Trappings"}}</a>
	<a class="item" data-tab="talents" onclick="setTab('talents')">{{localize "Talents"}} {{localize "and"}} {{localize "Traits"}}</a>
	<a class="item" data-tab="magic" onclick="setTab('magic')">{{localize "Magic"}} {{localize "and"}} {{localize "Religion"}}</a>
</nav>
<section class="tabs_content">
	<div class="tab" data-tab="details">
		<div id="details">
			{{#each data}}
				<div class="content" data-uuid="{{id}}">
					<a data-name="char_name" data-link="" data-uuid="{{id}}" data-tooltip="{{name}}<br><br>{{localize 'Species'}}: {{species}}<br>{{localize 'Gender'}}: {{gender}}<br>{{localize 'Age'}}: {{age}}<br>{{localize 'CharacterHeight'}}: {{height}}<br>{{localize 'Weight'}}: {{weight}}<br>{{localize 'Hair Colour'}}: {{haircolour}}<br>{{localize 'Eye Colour'}}: {{eyecolour}}"><img src="{{image}}" alt="{{localize 'Image'}}">&nbsp;<span data-name="short_name">{{shortName}}</span></a>
					<div>{{localize "Wounds"}}:&nbsp;<a onmousedown="editValue(event)" data-name="wounds" data-value="system.status.wounds.value" data-uuid="{{id}}" data-tooltip="{{localize 'Current'}}">{{wounds.current}}</a>&nbsp;/&nbsp;<span data-name="wounds_max" data-tooltip="{{localize 'Total'}}">{{wounds.max}}</span></div>
					<div>{{localize "Fate"}}:&nbsp;<a onmousedown="editValue(event)" data-name="fortune" data-value="system.status.fortune.value" data-uuid="{{id}}" data-tooltip="{{localize 'Fortune'}}">{{fate.fortune}}</a>&nbsp;/&nbsp;<a onmousedown="editValue(event)" data-name="fate" data-value="system.status.fate.value" data-uuid="{{id}}" data-tooltip="{{localize 'Fate'}}">{{fate.fate}}</a></div>
					<div>{{localize "Resilience"}}:&nbsp;<a onmousedown="editValue(event)" data-name="resolve" data-value="system.status.resolve.value" data-uuid="{{id}}" data-tooltip="{{localize 'Resolve'}}">{{resilience.resolve}}</a>&nbsp;/&nbsp;<a onmousedown="editValue(event)" data-name="resilience" data-value="system.status.resilience.value" data-uuid="{{id}}" data-tooltip="{{localize 'Resilience'}}">{{resilience.resilience}}</a></div>
					<div data-tooltip="{{localize 'Current'}}: {{experience.current}}<br>{{localize 'Spent'}}: {{experience.spent}}<br>{{localize 'Total'}}: {{experience.total}}" data-name="experience_tooltip">{{localize "Experience"}}:&nbsp;<span data-name="experience">{{experience.current}}</span></div>
					<div>{{localize "Encumbrance"}}:&nbsp;<span data-name="encumbrance" data-tooltip="{{localize 'Encumbrance'}}">{{encumbrance.total}}</span>&nbsp;/&nbsp;<span data-name="encumbrance_max" data-tooltip="{{localize 'Max'}}">{{encumbrance.max}}</span></div>
					<div>{{localize "Movement"}}:&nbsp;<span data-name="movement" data-tooltip="{{localize 'Move'}}">{{move.movement}}</span>&nbsp;/&nbsp;<span data-name="walk" data-tooltip="{{localize 'Walk'}}">{{move.walk}}</span>&nbsp;/&nbsp;<span data-name="run" data-tooltip="{{localize 'Run'}}">{{move.run}}</span></div>
					<div data-tooltip="{{localize 'Personal Ambitions'}}.<br><br>{{localize 'Short Term'}}: {{ambitions.personal.short}}<br>{{localize 'Long Term'}}: {{ambitions.personal.long}}<br><br>{{localize 'Party Ambitions'}}.<br><br>{{localize 'Short Term'}}: {{ambitions.party.short}}<br>{{localize 'Long Term'}}: {{ambitions.party.long}}" data-name="motivation_tooltip">{{localize "Motivation"}}:&nbsp;<span data-name="motivation">{{ambitions.motivation}}</span></div>
					<a data-link="" data-uuid="{{career.id}}" data-tooltip="{{localize 'Status'}}: {{status}}<br>{{localize 'Class'}}: {{class}}<br>{{localize 'Careers'}}: {{careerpath}}" data-name="career_tooltip"><span data-name="career">{{career.name}}&nbsp;({{careerlevel}})</span></a>
				</div>
			{{/each}}
		</div>
	</div>
	<div class="tab" data-tab="characteristics">
		<div class="header_h">
			<a oncontextmenu="sortGMPanel(0, 'characteristics')">{{localize "Name"}}</a>
			<a oncontextmenu="sortGMPanel(1, 'characteristics')">{{localize "CHARAbbrev.WS"}}</a>
			<a oncontextmenu="sortGMPanel(2, 'characteristics')">{{localize "CHARAbbrev.BS"}}</a>
			<a oncontextmenu="sortGMPanel(3, 'characteristics')">{{localize "CHARAbbrev.S"}}</a>
			<a oncontextmenu="sortGMPanel(4, 'characteristics')">{{localize "CHARAbbrev.T"}}</a>
			<a oncontextmenu="sortGMPanel(5, 'characteristics')">{{localize "CHARAbbrev.I"}}</a>
			<a oncontextmenu="sortGMPanel(6, 'characteristics')">{{localize "CHARAbbrev.Ag"}}</a>
			<a oncontextmenu="sortGMPanel(7, 'characteristics')">{{localize "CHARAbbrev.Dex"}}</a>
			<a oncontextmenu="sortGMPanel(8, 'characteristics')">{{localize "CHARAbbrev.Int"}}</a>
			<a oncontextmenu="sortGMPanel(9, 'characteristics')">{{localize "CHARAbbrev.WP"}}</a>
			<a oncontextmenu="sortGMPanel(10, 'characteristics')">{{localize "CHARAbbrev.Fel"}}</a>
		</div>
		<div id="characteristics">
			{{#each data}}
				<div class="content" data-uuid="{{id}}">
					<a data-link="" data-uuid="{{id}}" data-tooltip="{{name}}" data-name="char_name"><img src="{{image}}" alt="{{localize 'Image'}}">&nbsp;<span data-name="short_name">{{shortName}}</span></a>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.ws.initial}}<br>{{localize 'Advances'}}: {{characteristics.ws.advances}}<br>{{localize 'Modifier'}}: {{characteristics.ws.modifier}}">{{characteristics.ws.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.bs.initial}}<br>{{localize 'Advances'}}: {{characteristics.bs.advances}}<br>{{localize 'Modifier'}}: {{characteristics.bs.modifier}}">{{characteristics.bs.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.s.initial}}<br>{{localize 'Advances'}}: {{characteristics.s.advances}}<br>{{localize 'Modifier'}}: {{characteristics.s.modifier}}">{{characteristics.s.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.t.initial}}<br>{{localize 'Advances'}}: {{characteristics.t.advances}}<br>{{localize 'Modifier'}}: {{characteristics.t.modifier}}">{{characteristics.t.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.i.initial}}<br>{{localize 'Advances'}}: {{characteristics.i.advances}}<br>{{localize 'Modifier'}}: {{characteristics.i.modifier}}">{{characteristics.i.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.ag.initial}}<br>{{localize 'Advances'}}: {{characteristics.ag.advances}}<br>{{localize 'Modifier'}}: {{characteristics.ag.modifier}}">{{characteristics.ag.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.dex.initial}}<br>{{localize 'Advances'}}: {{characteristics.dex.advances}}<br>{{localize 'Modifier'}}: {{characteristics.dex.modifier}}">{{characteristics.dex.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.int.initial}}<br>{{localize 'Advances'}}: {{characteristics.int.advances}}<br>{{localize 'Modifier'}}: {{characteristics.int.modifier}}">{{characteristics.int.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.wp.initial}}<br>{{localize 'Advances'}}: {{characteristics.wp.advances}}<br>{{localize 'Modifier'}}: {{characteristics.wp.modifier}}">{{characteristics.wp.current}}</span>
					<span data-tooltip="{{localize 'Initial'}}: {{characteristics.fel.initial}}<br>{{localize 'Advances'}}: {{characteristics.fel.advances}}<br>{{localize 'Modifier'}}: {{characteristics.fel.modifier}}">{{characteristics.fel.current}}</span>
				</div>
			{{/each}}
		</div>
	</div>
	<div class="tab" data-tab="skills">
		<div class="header_v">
			<a oncontextmenu="sortGMPanel(0, 'skills')">{{localize "Skill"}}&nbsp;/&nbsp;{{localize "Name"}}</a>
			{{#each skillsList}}
				<a data-link="" data-uuid="{{this.id}}" oncontextmenu="sortGMPanel({{@index}} + 1, 'skills')" data-tooltip="{{localize 'Skill'}}"><img src="{{this.image}}" alt="{{localize 'Image'}}">&nbsp;{{this.name}}</a>
			{{/each}}
		</div>
		<div id="skills">
			{{#each data as |player|}}
				<div class="content" data-uuid="{{player.id}}">
					<a data-link="" data-uuid="{{player.id}}" data-tooltip="{{player.name}}" data-name="char_name"><img src="{{player.image}}" alt="{{localize 'Image'}}">&nbsp;<span data-name="short_name">{{player.shortName}}</span></a>
					{{#each ../skillsList as |skill|}}
						{{contains skill.name player.skills}}
					{{/each}}
				</div>
			{{/each}}
		</div>
	</div>
	<div class="tab" data-tab="trappings">
	</div>
	<div class="tab" data-tab="talents">
	</div>
	<div class="tab" data-tab="magic">
	</div>
</section>

<script>
	function setTab(tab) {window.GMPanel_tab = tab};
	if (!sortType) {var sortType = true};
	function sortGMPanel(index, containerID) {
		let switching = true;
		while (switching) {
			switching = false;
			let sortableElements = document.getElementById(containerID).getElementsByTagName("div");
			for (let i = 0; i < (sortableElements.length - 1); i++) {
				shouldSwitch = false;
				if (sortableElements[i].children[index].innerHTML.toLowerCase() > sortableElements[i + 1].children[index].innerHTML.toLowerCase() && sortType) {
					sortableElements[i].parentNode.insertBefore(sortableElements[i + 1], sortableElements[i]);
					switching = true;
					break;
				}
				else if (sortableElements[i].children[index].innerHTML.toLowerCase() < sortableElements[i + 1].children[index].innerHTML.toLowerCase() && !sortType) {
					sortableElements[i].parentNode.insertBefore(sortableElements[i], sortableElements[i + 2]);
					switching = true;
					break;
				};
			};
		};
		if (sortType) {sortType = false} else {sortType = true};
		return false;
	};
	function editValue(event) {
		let html = event.currentTarget;
		let data = html.dataset.value;
		let actor = game.actors.get(html.dataset.uuid.replace("Actor.", ""));
		let newValue = event.button == 0 ? data.split('.').reduce((o,i)=> o[i], actor) + 1 : data.split('.').reduce((o,i)=> o[i], actor) - 1;
		actor.update({[`${data}`]: newValue}).then(a => {
			try {html.innerHTML = data.split('.').reduce((o,i)=> o[i], a)}
			catch(error) {console.error(game.i18n.localize("WFRP4E.Assistant.GMPanel.Error.Title") + " (" + error + ")")};
		});
	};
</script>